<style>
    :root {
      --teal:       #088178;
      --teal-dark:  #046963;
      --teal-light: #e6f4f2;
      --teal-mid:   #c2dedd;
      --ink:        #1a2420;
      --mid:        #6b7f7c;
      --border:     #d8e8e6;
      --serif:      'Cormorant Garamond', serif;
      --sans:       'DM Sans', sans-serif;
    }
    
    .muse-footer {
      background: var(--ink);
      font-family: var(--sans);
      color: rgba(255,255,255,0.45);
    }
    
    /* ── TOP BAND ── */
    .footer-top-band {
      background: var(--teal);
      padding: 22px 80px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }
    
    .footer-top-band p {
      font-size: 13px;
      letter-spacing: 0.08em;
      color: rgba(255,255,255,0.9);
      font-weight: 300;
      margin: 0;
    }
    
    .footer-top-band strong {
      font-weight: 500;
      color: white;
    }
    
    .footer-newsletter {
      display: flex;
      gap: 0;
    }
    
    .footer-newsletter input {
      padding: 11px 18px;
      background: rgba(255,255,255,0.15);
      border: 1px solid rgba(255,255,255,0.25);
      border-right: none;
      color: white;
      font-family: var(--sans);
      font-size: 12px;
      outline: none;
      width: 230px;
    }
    .footer-newsletter input::placeholder { color: rgba(255,255,255,0.5); }
    
    .footer-newsletter button {
      padding: 11px 22px;
      background: white;
      color: var(--teal-dark);
      border: none;
      font-family: var(--sans);
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.2s;
    }
    .footer-newsletter button:hover { background: var(--teal-light); }
    
    /* ── MAIN FOOTER ── */
    .footer-main {
      padding: 70px 80px 50px;
      display: grid;
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
      gap: 60px;
    }
    
    /* brand column */
    .footer-brand .logo-link {
      display: inline-flex;
      flex-direction: column;
      align-items: flex-start;
      text-decoration: none;
      margin-bottom: 20px;
    }
    .footer-brand .lw {
      font-family: var(--serif);
      font-style: italic;
      font-weight: 300;
      font-size: 32px;
      letter-spacing: 0.18em;
      color: white;
      line-height: 1;
    }
    .footer-brand .lr {
      height: 1px;
      width: 100%;
      background: linear-gradient(90deg, var(--teal), transparent);
      margin: 4px 0 3px;
    }
    .footer-brand .ls {
      font-size: 7.5px;
      letter-spacing: 0.5em;
      text-transform: uppercase;
      color: var(--teal-mid);
      font-weight: 500;
    }
    
    .footer-brand p {
      font-size: 13px;
      line-height: 1.8;
      font-weight: 300;
      max-width: 260px;
      margin-bottom: 28px;
    }
    
    .footer-social {
      display: flex;
      gap: 12px;
    }
    
    .footer-social a {
      width: 36px; height: 36px;
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: border-color 0.2s, background 0.2s;
    }
    
    .footer-social a:hover {
      border-color: var(--teal);
      background: rgba(8,129,120,0.15);
    }
    
    .footer-social img {
      width: 15px; height: 15px;
      filter: brightness(0) invert(0.6);
      transition: filter 0.2s;
    }
    .footer-social a:hover img { filter: brightness(0) invert(1); }
    
    /* link columns */
    .footer-col h5 {
      font-family: var(--sans);
      font-size: 10px;
      letter-spacing: 0.35em;
      text-transform: uppercase;
      color: white;
      font-weight: 500;
      margin: 0 0 22px;
      position: relative;
      padding-bottom: 14px;
    }
    
    .footer-col h5::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0;
      width: 24px; height: 1px;
      background: var(--teal);
    }
    
    .footer-col ul {
      list-style: none;
      padding: 0; margin: 0;
      display: flex;
      flex-direction: column;
      gap: 11px;
    }
    
    .footer-col ul li a {
      color: rgba(255,255,255,0.42);
      text-decoration: none;
      font-size: 13px;
      font-weight: 300;
      letter-spacing: 0.02em;
      transition: color 0.2s, padding-left 0.2s;
      display: inline-block;
    }
    
    .footer-col ul li a:hover {
      color: var(--teal-mid);
      padding-left: 4px;
    }
    
    /* ── DIVIDER ── */
    .footer-divider {
      margin: 0 80px;
      height: 1px;
      background: rgba(255,255,255,0.06);
    }
    
    /* ── BOTTOM ── */
    .footer-bottom {
      padding: 24px 80px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }
    
    .footer-bottom p {
      font-size: 12px;
      font-weight: 300;
      margin: 0;
      letter-spacing: 0.03em;
    }
    
    .footer-bottom strong {
      font-weight: 500;
      color: var(--teal-mid);
    }
    
    .footer-bottom-links {
      display: flex;
      gap: 28px;
    }
    
    .footer-bottom-links a {
      color: rgba(255,255,255,0.3);
      text-decoration: none;
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      transition: color 0.2s;
    }
    .footer-bottom-links a:hover { color: var(--teal-mid); }
    
    /* ── RESPONSIVE ── */
    @media (max-width: 1024px) {
      .footer-top-band { padding: 20px 32px; }
      .footer-main { padding: 60px 32px 40px; grid-template-columns: 1fr 1fr; gap: 40px; }
      .footer-divider { margin: 0 32px; }
      .footer-bottom { padding: 20px 32px; }
    }
    
    @media (max-width: 640px) {
      .footer-top-band { flex-direction: column; padding: 24px 20px; text-align: center; }
      .footer-newsletter input { width: 180px; }
      .footer-main { padding: 48px 20px 32px; grid-template-columns: 1fr 1fr; gap: 32px; }
      .footer-divider { margin: 0 20px; }
      .footer-bottom { padding: 20px; flex-direction: column; text-align: center; gap: 12px; }
    }
    </style>
    
    <footer class="muse-footer">
    
      <!-- TOP BAND -->
      <div class="footer-top-band">
        <p><strong>Free shipping</strong> on all orders over $60 &nbsp;·&nbsp; Handcrafted with care</p>
        <div class="footer-newsletter">
          <input type="email" placeholder="Your email for exclusive offers">
          <button type="button">Subscribe</button>
        </div>
      </div>
    
      <!-- MAIN GRID -->
      <div class="footer-main">
    
        <!-- Brand -->
        <div class="footer-brand">
          <a href="/home" class="logo-link">
            <span class="lw">Muse</span>
            <span class="lr"></span>
            <span class="ls">Collection</span>
          </a>
          <p>Handcrafted ceramics and home décor designed to bring warmth and elegance to everyday living.</p>
          <div class="footer-social">
            <a href="#" aria-label="Facebook">
              <img src="/user_assets/imgs/theme/icons/icon-facebook.svg" alt="Facebook">
            </a>
            <a href="#" aria-label="Instagram">
              <img src="/user_assets/imgs/theme/icons/icon-instagram.svg" alt="Instagram">
            </a>
            <a href="#" aria-label="Pinterest">
              <img src="/user_assets/imgs/theme/icons/icon-pinterest.svg" alt="Pinterest">
            </a>
          </div>
        </div>
    
        <!-- Shop -->
        <div class="footer-col">
          <h5>Shop</h5>
          <ul>
            <li><a href="/shop">All Products</a></li>
            <li><a href="/shop?search=ceramics">Ceramics</a></li>
            <li><a href="/shop?search=decore">Home Decor</a></li>
            <li><a href="/shop?sort=new">New Arrivals</a></li>
          </ul>
        </div>
    
        <!-- My Account -->
        <div class="footer-col">
          <h5>My Account</h5>
          <ul>
            <% if(userAuthenticated){ %>
            <li><a href="/profile">Profile</a></li>
            <li><a href="/cart">Cart</a></li>
            <li><a href="/wishlist">Wishlist</a></li>
            <li><a href="/orders">Orders</a></li>
            <% } else { %>
            <li><a href="/login">Login</a></li>
            <li><a href="/signup">Sign Up</a></li>
            <li><a href="/shop">Shop</a></li>
            <% } %>
          </ul>
        </div>
    
        <!-- Support -->
        <div class="footer-col">
          <h5>Support</h5>
          <ul>
            <li><a href="/contact">Contact Us</a></li>
            <li><a href="/shipping">Shipping</a></li>
            <li><a href="/returns">Returns</a></li>
            <li><a href="/faq">FAQ</a></li>
          </ul>
        </div>
    
      </div>
    
      <div class="footer-divider"></div>
    
      <!-- BOTTOM -->
      <div class="footer-bottom">
        <p>© 2026 <strong>MUSE</strong>. All rights reserved.</p>
        <div class="footer-bottom-links">
          <a href="#">Privacy Policy</a>
          <a href="#">Terms of Use</a>
        </div>
      </div>
    
    </footer>