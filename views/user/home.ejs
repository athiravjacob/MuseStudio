<%- include('../layoutUser/header.ejs') %>
<%- include('../layoutUser/navigation.ejs') %>

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

<style>
:root {
  --teal:       #088178;
  --teal-dark:  #046963;
  --teal-light: #e6f4f2;
  --teal-mid:   #c2dedd;
  --ink:        #1a2420;
  --sand:       #f7f4ef;
  --mid:        #6b7f7c;
  --border:     #d8e8e6;
  --serif:      'Cormorant Garamond', serif;
  --sans:       'DM Sans', sans-serif;
}

body {
  font-family: var(--sans);
  background: var(--sand);
  color: var(--ink);
  margin: 0;
}

/* ── HERO ── */
.hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 88vh;
  overflow: hidden;
}

.hero-left {
  background: var(--teal-light);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 80px 64px;
  position: relative;
  overflow: hidden;
}

/* decorative rings */
.hero-left::before {
  content: '';
  position: absolute;
  top: -80px; left: -80px;
  width: 320px; height: 320px;
  border: 1px solid rgba(8,129,120,0.15);
  border-radius: 50%;
  pointer-events: none;
}
.hero-left::after {
  content: '';
  position: absolute;
  bottom: -60px; right: 40px;
  width: 200px; height: 200px;
  border: 1px solid rgba(8,129,120,0.1);
  border-radius: 50%;
  pointer-events: none;
}

.hero-eyebrow {
  font-family: var(--sans);
  font-size: 10px;
  letter-spacing: 0.42em;
  text-transform: uppercase;
  color: var(--teal);
  font-weight: 500;
  margin-bottom: 18px;
  animation: fadeUp 0.6s ease both;
}

.hero h1 {
  font-family: var(--serif);
  font-weight: 300;
  font-size: clamp(36px, 4.5vw, 60px);
  line-height: 1.1;
  color: var(--ink);
  margin: 0 0 22px;
  animation: fadeUp 0.6s 0.1s ease both;
}

.hero h1 em {
  font-style: italic;
  color: var(--teal);
  display: block;
}

.hero-left p {
  font-family: var(--sans);
  font-size: 15px;
  line-height: 1.8;
  color: var(--mid);
  font-weight: 300;
  max-width: 380px;
  margin: 0 0 40px;
  animation: fadeUp 0.6s 0.2s ease both;
}

.hero-cta {
  display: flex;
  gap: 14px;
  animation: fadeUp 0.6s 0.3s ease both;
}

.btn-shop {
  display: inline-block;
  background: var(--teal);
  color: white;
  padding: 13px 34px;
  text-decoration: none;
  font-family: var(--sans);
  font-size: 11px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  font-weight: 500;
  transition: background 0.25s, transform 0.2s;
}
.btn-shop:hover { background: var(--teal-dark); transform: translateY(-1px); }

.btn-ghost {
  display: inline-block;
  border: 1.5px solid var(--teal);
  color: var(--teal);
  padding: 12px 30px;
  text-decoration: none;
  font-family: var(--sans);
  font-size: 11px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  font-weight: 500;
  transition: all 0.25s;
}
.btn-ghost:hover { background: var(--teal); color: white; }

/* hero right image panel */
.hero-right {
  position: relative;
  overflow: hidden;
  background: var(--teal-mid);
}

.hero-right img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 8s ease;
}
.hero-right:hover img { transform: scale(1.05); }

/* floating stat badge */
.hero-badge {
  position: absolute;
  bottom: 44px; left: 0;
  background: white;
  border-left: 3px solid var(--teal);
  padding: 18px 28px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.1);
}
.hero-badge .badge-num {
  font-family: var(--serif);
  font-size: 32px;
  color: var(--teal);
  font-weight: 300;
  line-height: 1;
}
.hero-badge .badge-lbl {
  font-family: var(--sans);
  font-size: 9px;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--mid);
  margin-top: 4px;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(18px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ── MARQUEE ── */
.marquee-strip {
  background: var(--teal);
  padding: 13px 0;
  overflow: hidden;
  white-space: nowrap;
}
.marquee-inner {
  display: inline-block;
  animation: marquee 24s linear infinite;
}
.marquee-item {
  display: inline-block;
  font-family: var(--sans);
  font-size: 10px;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.9);
  font-weight: 500;
  margin: 0 36px;
}
.marquee-dot {
  display: inline-block;
  width: 3px; height: 3px;
  border-radius: 50%;
  background: rgba(255,255,255,0.4);
  vertical-align: middle;
}
@keyframes marquee {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

/* ── CATEGORIES ── */
.categories {
  padding: 90px 80px;
  max-width: 1280px;
  margin: 0 auto;
}

.section-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 48px;
}

.section-meta { display: flex; flex-direction: column; gap: 8px; }

.section-eyebrow {
  font-family: var(--sans);
  font-size: 10px;
  letter-spacing: 0.4em;
  text-transform: uppercase;
  color: var(--teal);
  font-weight: 500;
}

.categories h2, .products h2 {
  font-family: var(--serif);
  font-weight: 300;
  font-size: clamp(28px, 3.5vw, 42px);
  color: var(--ink);
  line-height: 1.1;
  margin: 0;
}

.categories h2 em { font-style: italic; color: var(--teal); }

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.category-card {
  position: relative;
  overflow: hidden;
  cursor: pointer;
  background: var(--teal-mid);
  border-radius: 2px;
}

.category-card::after {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(4,105,99,0.82) 0%, rgba(4,105,99,0.1) 55%, transparent 100%);
  transition: opacity 0.35s;
}
.category-card:hover::after { opacity: 1.2; }

.category-card img {
  width: 100%; height: 290px;
  object-fit: cover;
  display: block;
  transition: transform 0.6s ease;
}
.category-card:hover img { transform: scale(1.07); }

.cat-info {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  z-index: 2;
  padding: 24px 22px;
}

.cat-info h3 {
  font-family: var(--serif);
  font-weight: 300;
  font-size: 22px;
  color: white;
  margin: 0 0 10px;
}

.cat-info a {
  display: inline-block;
  font-family: var(--sans);
  font-size: 9.5px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--teal-mid);
  text-decoration: none;
  border-bottom: 1px solid rgba(194,222,221,0.5);
  padding-bottom: 2px;
  transition: color 0.2s, border-color 0.2s;
}
.cat-info a:hover { color: white; border-color: white; }

/* ── PRODUCTS ── */
.products {
  padding: 0 80px 90px;
  max-width: 1280px;
  margin: 0 auto;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  margin-top: 48px;
}

.product-card {
  background: white;
  border: 1px solid var(--border);
  transition: box-shadow 0.3s, transform 0.3s;
}
.product-card:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(8,129,120,0.1); }

.product-card a {
  display: block;
  text-decoration: none;
  color: inherit;
}

.product-card img {
  width: 100%; height: 240px;
  object-fit: cover;
  display: block;
  transition: transform 0.5s;
}
.product-card:hover img { transform: scale(1.04); }

.product-card h4 {
  font-family: var(--serif);
  font-weight: 400;
  font-size: 17px;
  color: var(--ink);
  padding: 14px 16px 4px;
}

.price {
  padding: 8px 16px 18px;
  display: flex;
  gap: 8px;
  align-items: center;
}

.price .offer {
  font-family: var(--sans);
  font-size: 15px;
  font-weight: 500;
  color: var(--teal);
}

.price .old {
  font-size: 13px;
  color: #aaa;
  text-decoration: line-through;
}

.price span:not(.offer):not(.old) {
  font-size: 15px;
  font-weight: 500;
  color: var(--ink);
}

/* ── ABOUT ── */
.about {
  background: white;
  overflow: hidden;
}

.about-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  max-width: 1280px;
  margin: 0 auto;
  min-height: 520px;
}

.about-text {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 80px;
}

.about-text h2 {
  font-family: var(--serif);
  font-weight: 300;
  font-size: clamp(28px, 3.5vw, 44px);
  color: var(--ink);
  margin-bottom: 20px;
  line-height: 1.1;
}

.about-text h2 em { font-style: italic; color: var(--teal); }

.about-text p {
  font-size: 15px;
  line-height: 1.8;
  color: var(--mid);
  margin-bottom: 36px;
  font-weight: 300;
  max-width: 400px;
}

.about-image { overflow: hidden; background: var(--teal-mid); }
.about-image img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s; }
.about-image:hover img { transform: scale(1.04); }

/* ── FEATURES ── */
.features {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid var(--border);
}

.feature {
  padding: 48px 36px;
  text-align: center;
  border-right: 1px solid var(--border);
  background: white;
  transition: background 0.25s;
}
.feature:last-child { border-right: none; }
.feature:hover { background: var(--teal-light); }

.feature-icon {
  width: 46px; height: 46px;
  border: 1.5px solid var(--teal);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 18px;
  color: var(--teal);
}

.feature h3 {
  font-family: var(--serif);
  font-weight: 400;
  font-size: 19px;
  color: var(--ink);
  margin-bottom: 10px;
}

.feature p {
  font-size: 13px;
  color: var(--mid);
  line-height: 1.65;
  font-weight: 300;
}

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .categories, .products { padding: 60px 32px; }
  .category-grid { grid-template-columns: repeat(2, 1fr); }
  .product-grid { grid-template-columns: repeat(2, 1fr); }
  .hero { grid-template-columns: 1fr; }
  .hero-right { height: 55vw; }
  .hero-left { padding: 60px 40px; }
  .about-content { grid-template-columns: 1fr; }
  .about-image { height: 340px; }
  .features { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 640px) {
  .categories, .products { padding: 48px 20px; }
  .category-grid, .product-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
  .hero-left { padding: 48px 24px; }
  .features { grid-template-columns: 1fr 1fr; }
  .about-text { padding: 48px 24px; }
  .section-header { flex-direction: column; align-items: flex-start; gap: 16px; }
}
</style>

<main>

<!-- HERO SECTION -->
<section class="hero">
  <div class="hero-left">
    <p class="hero-eyebrow">New Collection 2025</p>
    <h1>Elegant Ceramic<br><em>&amp; Home Decor</em></h1>
    <p>Handcrafted ceramics and beautiful decor to transform your home into a sanctuary of style.</p>
    <div class="hero-cta">
      <a href="/shop" class="btn-shop">Shop Collection</a>
      <a href="#categories" class="btn-ghost">Browse Categories</a>
    </div>
  </div>
  <div class="hero-right">
    <img src="/user_assets/imgs/hero-img3.jpg" alt="Ceramic & Home Decor">
    <div class="hero-badge">
      <div class="badge-num">200+</div>
      <div class="badge-lbl">Unique Pieces</div>
    </div>
  </div>
</section>

<!-- MARQUEE STRIP -->
<div class="marquee-strip" aria-hidden="true">
  <div class="marquee-inner">
    <span class="marquee-item">Free shipping over $60</span><span class="marquee-dot"></span>
    <span class="marquee-item">Handcrafted ceramics</span><span class="marquee-dot"></span>
    <span class="marquee-item">Artisan quality</span><span class="marquee-dot"></span>
    <span class="marquee-item">New arrivals weekly</span><span class="marquee-dot"></span>
    <span class="marquee-item">Secure checkout</span><span class="marquee-dot"></span>
    <span class="marquee-item">Free shipping over $60</span><span class="marquee-dot"></span>
    <span class="marquee-item">Handcrafted ceramics</span><span class="marquee-dot"></span>
    <span class="marquee-item">Artisan quality</span><span class="marquee-dot"></span>
    <span class="marquee-item">New arrivals weekly</span><span class="marquee-dot"></span>
    <span class="marquee-item">Secure checkout</span><span class="marquee-dot"></span>
  </div>
</div>

<!-- CATEGORIES -->
<section class="categories" id="categories">
  <div class="section-header">
    <div class="section-meta">
      <p class="section-eyebrow">Browse by Style</p>
      <h2>Shop by <em>Category</em></h2>
    </div>
    <a href="/shop" class="btn-ghost">View All</a>
  </div>

  <div class="category-grid">
    <% category.forEach(cat => { %>
      <% if(cat.status){ %>
      <div class="category-card">
        <img src="/uploads/<%=cat.image%>" alt="<%=cat.name%>">
        <div class="cat-info">
          <h3><%=cat.name%></h3>
          <a href="/shop?category=<%=cat._id%>">Explore →</a>
        </div>
      </div>
      <% } %>
    <% }); %>
  </div>
</section>


<!-- FEATURED PRODUCTS -->
<section class="products">
  <div class="section-header">
    <div class="section-meta">
      <p class="section-eyebrow">Hand-Picked for You</p>
      <h2>Featured Products</h2>
    </div>
    <a href="/shop" class="btn-ghost">View All Products</a>
  </div>

  <div class="product-grid">
    <% products.slice(0,8).forEach(product => { %>
    <div class="product-card">
      <a href="/productDetails/<%=product._id%>">
        <img src="<%=product.images[0]%>" alt="<%=product.name%>">
        <h4><%=product.name%></h4>
      </a>
      <div class="price">
        <% if(product.isDiscounted){ %>
          <span class="offer">$<%=product.offerPrice%></span>
          <span class="old">$<%=product.originalPrice%></span>
        <% } else { %>
          <span>$<%=product.originalPrice%></span>
        <% } %>
      </div>
    </div>
    <% }) %>
  </div>
</section>


<!-- BRAND STORY -->
<section class="about">
  <div class="about-content">
    <div class="about-text">
      <h2>Crafted With <em>Passion</em></h2>
      <p>
        Our ceramic collections are carefully designed to bring warmth and beauty
        into every home. Each piece is crafted with attention to detail and timeless design.
      </p>
      <a href="/shop" class="btn-shop">Discover More</a>
    </div>
    <div class="about-image">
      <img src="/user_assets/imgs/hero-img1.jpg" alt="Crafted with passion">
    </div>
  </div>
</section>


<!-- WHY CHOOSE US -->
<section class="features">
  <div class="feature">
    <div class="feature-icon">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 18l-6.2 3.1 1.2-6.9L2 9.3l6.9-1z"/></svg>
    </div>
    <h3>Premium Quality</h3>
    <p>Handcrafted ceramic products with premium materials</p>
  </div>
  <div class="feature">
    <div class="feature-icon">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </div>
    <h3>Fast Delivery</h3>
    <p>Quick and safe shipping across the country</p>
  </div>
  <div class="feature">
    <div class="feature-icon">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    </div>
    <h3>Secure Payment</h3>
    <p>Multiple secure payment options available</p>
  </div>
  <div class="feature">
    <div class="feature-icon">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    </div>
    <h3>24/7 Support</h3>
    <p>Friendly support whenever you need help</p>
  </div>
</section>

</main>

<%- include('../layoutUser/footer.ejs') %>