<%-include('../layoutUser/header.ejs') %>
    
    <%-include('../layoutUser/navigation.ejs') %>
    
    <main class="main">
       
        <section class="mt-50 mb-50">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="product-detail accordion-detail">
                            <div class="row mb-50">
                                <div class="col-md-6 col-sm-12 col-xs-12">
                                    <div class="detail-gallery">
                                        <span class="zoom-icon"><i class="fi-rs-search"></i></span>
                                        <!-- MAIN SLIDES -->
                                        <% if (product.images.length > 0) { %>
                                            <div class="product-image-slider ">
                                                <figure class="border-radius-10" id="image-container" style="position: relative; overflow: hidden;">
                                                    <img  id="main-image" style="transition: transform 0.2s ease; width: 100%; height: auto; overflow: hidden;" src="/<%= product.images[0] %>" alt="product image">
                                                </figure>
                                            </div>
                                            <!-- THUMBNAILS -->
                                            <div class="slider-nav-thumbnails pl-15 pr-15 d-flex flex-row gap-1">
                                                <% product.images.forEach((image, index) => { %>
                                                    <div class="thumbnail d-flex flex-row">
                                                        <img src="/<%= image %>" alt="product image" width="150px" data-index="<%= index %>" data-full="/<%= image %>">
                                                    </div>
                                                <% }) %>
                                            </div>
                                        <% } %>
                                    </div>
                                    <!-- End Gallery -->
                                </div>
                            
        
       
        
                                <div class="col-md-6 col-sm-12 col-xs-12">
                                    
                                    <div class="detail-info">
                                        <h2 class="title-detail"><%=product.name %></h2>
                                        <div class="product-detail-rating">
                                            <div class="pro-details-brand">
                                                <span> Brands: <a href="shop-grid-right.html"><%=product.brand %></a></span>
                                            </div>
                                            
                                        </div>
                                        <div class="clearfix product-price-cover">
                                            <div class="product-price primary-color float-left">
                                                <% if(!product.isDiscounted){ %>
                                                    <ins><span class="text-brand " id="productPrice">₹<%=product.originalPrice %></span></ins>
                                                <% }else{ %>
                                                    <ins><span class="text-brand " id="productPrice">₹<%=product.offerPrice %></span></ins>
                                                    <ins><span class="old-price font-md ml-15">₹<%=product.originalPrice %></span></ins>
                                                    <span class="save-price  font-md color3 ml-15"><%=product.offerPercentage %>% Off</span>
                                                <% } %>
                                            </div>
                                        </div>
                                        <div class="bt-1 border-color-1 mt-15 mb-15"></div>
                                        <div class="short-desc mb-30">
                                            <p><%=product.description %></p>
                                        </div>
                                        <ul class="product-meta font-xs color-grey mt-50">
                                            <% if(product.quantity===0){ %>
                                           <p class="in-stock text-danger fw-bolder font-xl ml-5"><span class="text-black-50 fw-normal font-md">This product is currently unavilable</span></p>
                                        <% }  %>
                                        </ul>
                                        <div class="product_sort_info font-xs mb-30">
                                            <ul>
                                                <li class="mb-10"><i class="fi-rs-refresh mr-5"></i> 30 Day Return Policy</li>
                                                <li><i class="fi-rs-credit-card mr-5"></i> Cash on Delivery available</li>
                                            </ul>
                                        </div>
                                       
                                        <div class="bt-1 border-color-1 mt-30 mb-30">
                                            <% if(product.quantity >=0 &&product.quantity <10 ) {%>
                                                 <p class="text-muted">Only <span class="text-danger"><%=product.quantity %></span> left .Hurry Up</p>
                                            <% }else{ %>
                                            <p class="text-muted"> <span class="text-success"><%=product.quantity %></span> In Stock</p>
                                            <% } %>
                                        </div>
                                        <div class="detail-extralink">
                                            <% if(product.quantity >0 ){%>
                                            <div class="detail-qty border radius">
                                                <a href="#" onclick="qtydown()" class="qty-down"><i class="fi-rs-angle-small-down"></i></a>
                                                <span class="qty-val" id="productQty">1</span>
                                                <a href="#" onclick="qtyup('<%=product.quantity%>')" class="qty-up"><i class="fi-rs-angle-small-up"></i></a>
                                                <% } %>
                                            </div>
                                            <div class="product-extra-link2">
                                                <% if(product.quantity > 0){%>
                                                    <% 
                                                    let price
                                                    if(product.isDiscounted) price = product.offerPrice
                                                    else price = product.originalPrice
                                                    %>
                                                    <button  onclick="addToCart('<%=product._id%>','<%=price%>','<%=product.quantity%>')" id="addtocart-btn" class="button button-add-to-cart">Add to cart</button>
                                                <%}else{ %>
                                                <h5  class="text-danger">SOLD OUT</h5>
                                                <% } %>
                                                <a aria-label="Add To Wishlist" class="action-btn hover-up" href="#" onclick="wishlist('<%=product._id %>')"><i class="fi-rs-heart"></i></a>
                                            </div>
                                        </div>
                                        
                                    </div>
                                    <!-- Detail Info -->
                                </div>
                            </div>
                        
                            <% if(relatedProducts .length >0){ %>
                            <div class="row mt-60">
                                <div class="col-12">
                                    <h3 class="section-title style-1 mb-30">Related products</h3>
                                </div>
                               
                                <div class="col-12">
                                    <div class="row related-products">
                                        <% relatedProducts.forEach((product)=>{ %>
                                        <div class="col-lg-3 col-md-4 col-12 col-sm-6">
                                            <div class="product-cart-wrap small hover-up">
                                                <div class="product-img-action-wrap">
                                                    <div class="product-img product-img-zoom">
                                                        <a href="/productDetails/<%=product._id %>" tabindex="0">
                                                            <img class="default-img" src="/<%=product.images[0]%>" alt="">
                                                            <img class="hover-img" src="/<%=product.images[1]%>" alt="">
                                                        </a>
                                                    </div>
                                                    
                                                    <div class="product-badges product-badges-position product-badges-mrg">
                                                        <span class="hot">Hot</span>
                                                    </div>
                                                </div>
                                                <div class="product-content-wrap">
                                                    <h2><a href="/productDetails/<%=product._id %>" tabindex="0"><%= product.name %></a></h2>
                                                    <div class="rating-result" title="90%">
                                                        <span>
                                                        </span>
                                                    </div>
                                                    <div class="product-price">
                                                        <span>$<%=product.originalPrice %></span>
                                                       
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <% }) %>
                                    </div>
                                </div>
                               
                            </div>
                            <% } %>
                            
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        

        // ////////////////////////////////// Product Zoom /////////////////////////////

        document.addEventListener('DOMContentLoaded', () => {
            const container = document.getElementById('image-container')
            const mainImage = document.getElementById('main-image');
            const thumbnails = document.querySelectorAll('.thumbnail img');
    
            thumbnails.forEach(thumbnail => {
                thumbnail.addEventListener('click', () => {
                    const newSrc = thumbnail.getAttribute('data-full');
                    mainImage.setAttribute('src', newSrc);
                });
            });
            container.addEventListener('mousemove',(e)=>{
                const x = e.clientX - e.target.offsetLeft
                const y = e.clientY - e.target.offsetTop
                console.log(x,y)
                mainImage.style.transformOrigin= `${x}px ${y}px`
                mainImage.style.transform = "scale(2)"

       })

       container.addEventListener('mouseleave',(e)=>{
        mainImage.style.transformOrigin= "center"
                mainImage.style.transform = "scale(1)"
       })
        });
     /////////////////////// CHANGE QUANTITY ///////////////////////
     const qtyup = (stock)=>{
        const qtyValue = document.getElementById('productQty')
        const qty = parseInt(qtyValue.textContent,10)
        console.log(stock)
      
            if(qty < 5 && stock > qty )
            {
            qtyValue.textContent =qty+1
        }else{
            Swal.fire({
                    icon: 'Error',
                    title: 'Oops!',
                    text:"Cannot add more than 5 items",
                    showConfirmButton: false,
                    timer: 1500
                }).then(() => {
                    window.location.reload();
                });
        }
    
        
     }
     const qtydown = ()=>{
        const qtyValue = document.getElementById('productQty')
        const qty = parseInt(qtyValue.textContent,10)
        if(qty > 1){
            qtyValue.textContent =qty-1
        }
    }


      /////////////////////////////// ADD TO CART //////////////////////////////
      
    const addToCart = async (productid, productPrice, availableQty) => {
    const productQty = document.getElementById('productQty').textContent;
    console.log(`quantity: ${productQty}`);
    try {
        if (availableQty > 0) {
            const response = await fetch(`/cart/addtoCart`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ productid, productPrice, productQty })
            });

            const data = await response.json();

            if (response.ok) {
                Swal.fire({
                    icon: 'success',
                    title: 'Added to cart',
                    showConfirmButton: false,
                    timer: 1500
                }).then(() => {
                    window.location.reload();
                });
            } else {
                if (data.redirect) {
                    window.location.href = data.redirectUrl;
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: "Maximum Quantity Added"
                    });
                }
            }
        }
    } catch (error) {
        console.log(error);
        alert("Error adding to cart");
    }
}
     
    //////////////////////////// WISHLIST ///////////////////////
    const wishlist = async(id)=>{
        try {
            const response = await fetch("/wishlist",{
                method:'POST',
                headers:{'Content-Type':"application/json"},
                body:JSON.stringify({productId:id})
            })
            const data = await response.json();
            console.log(data)

            if(response.ok) {
                Swal.fire({
                    icon: 'success',
                    title: 'Wishlisted',
                    showConfirmButton: false,
                    timer: 1500
                }).then(() => {
                    window.location.reload();
                });
            }else {
                if (data.redirect) {
                    window.location.href = data.redirectUrl;
            
                }
            }
        } catch (error) {
            console.log(error)
        }
    }

   

    </script>
   <%-include('../layoutUser/footer.ejs') %>