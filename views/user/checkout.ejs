<%-include('../layoutUser/header.ejs') %>
<script src="https://www.paypal.com/sdk/js?client-id=<%=paypalId%>"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <%-include('../layoutUser/navigation.ejs') %>
    
    <main class="main">
       
        <section class="mt-50 mb-50">
            <div class="container">
                <div class="row">
                    <div class="col-md-6 border rounded p-3">
                        <div class="mb-25">
                            <h4>Billing Details</h4>
                        </div>
        
                        <div class="form-group">
                            <p>Name : <%=user.username %></p>                       
                            <p>Phone : <%=user.phone %></p>                          
                            <p>Email : <%=user.email %></p>
                        </div>
                        <% if(user.address.length !=0) {%>
                        <div>
                            <div class="d-flex justify-content-between">
                                <h6 id="selectedOptionText" class="my-2">Delivery Address</h6>
                                <% if(user.address.length >1) {%>
                                <a data-bs-toggle="collapse" data-target="#collapseAddress" href="#collapseAddress">change Address</a>
                                    <% } %>
                            </div>
                            <div class="my-1">
                                <% if(user.address) {%>
                                    <% user.address.forEach(addr=>{ %>
                                        <% if(addr.isDefault){ %>
                                            <p id="addr"> <%= addr.address%></p>
                                            <p id="cityState"><%=addr.city %>,<%=addr.state %> - <%=addr.pincode %></p>  
                                            <%}}) %>
                                    <% }%>
                            </div>
                            <div class="collapse in my-3" id="collapseAddress">
                                <% user.address.forEach((addr, index)=> { %>
                                    <div id="container<%=index %>" class="address-container mb-3">
                                        <div class="card">
                                            <div class="card-body">
                                                <div class="d-flex">
                                                    <div >
                                                        <p class="card-text mb-1"><%= addr.address %></p>
                                                        <p class="card-text mb-0"> <%= addr.city %>, <%= addr.state %> - <%= addr.pincode %></p>
                                                        <button class="btn btn-primary my-1" data-bs-toggle="collapse" data-target="#collapseAddress"                                    
                                                        href="#collapseAddress" onclick="changeSelectedAddress('<%=addr._id %>')" >select</button>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <% }) %>
                            </div>
                        </div>
                        <% } %>
                        <!-- Button trigger modal -->
                        
                        <% if( user.address.length ===0  ){ %>
                        <label class="my-5 fw-bolder" data-bs-toggle="collapse" data-target="#collapsediffAddress" href="#collapsediffAddress">Add your Shipping address </label>
                        <% }else{ %>
                            <label class="my-5" data-bs-toggle="collapse" data-target="#collapsediffAddress" href="#collapsediffAddress">Ship to
                                a different address? </label>
                        <% } %>
                        <div id="collapsediffAddress" class="collapse in">
                            <form id="form-diff-address">
                                <input type="text" name="address" required="" placeholder="Address *" class="form-control mb-3">
                                <input required="" type="text" name="city" placeholder="City / Town *"
                                    class="form-control mb-3">
                                <select placeholder="State  *" name="state" class="form-control mb-3">
                                    <option>Select State</option>
                                    <option>Andhra Pradesh</option>
                                    <option>Arunachal Pradesh</option>
                                    <option>Assam</option>
                                    <option>Bihar</option>
                                    <option>Chhattisgarh</option>
                                    <option>Goa</option>
                                    <option>Gujarat</option>
                                    <option>Haryana</option>
                                    <option>Himachal Pradesh</option>
                                    <option>Jharkhand</option>
                                    <option>Karnataka</option>
                                    <option>Kerala</option>
                                    <option>Madhya Pradesh</option>
                                    <option>Maharashtra</option>
                                    <option>Manipur</option>
                                    <option>Meghalaya</option>
                                    <option>Mizoram</option>
                                    <option>Nagaland</option>
                                    <option>Odisha</option>
                                    <option>Punjab</option>
                                    <option>Rajasthan</option>
                                    <option>Sikkim</option>
                                    <option>Tamil Nadu</option>
                                    <option>Telangana</option>
                                    <option>Tripura</option>
                                    <option>Uttar Pradesh</option>
                                    <option>Uttarakhand</option>
                                    <option>West Bengal</option>
                                    <option>Andaman and Nicobar Islands</option>
                                    <option>Chandigarh</option>
                                    <option>Dadra and Nagar Haveli and Daman and Diu</option>
                                    <option>Delhi</option>
                                    <option>Lakshadweep</option>
                                    <option>Puducherry</option>
                                </select>
                                
                                <input required="" type="text" name="zipcode" placeholder="PIN CODE *"
                                    class="form-control mb-3">
                            </form>
                            <button onclick="diffAddress('<%=user.id%>')" class="btn btn-primary mb-50 ">Save</button>
                        </div>
                       
        
                    </div>


                    <div class="col-md-6">
                        <div class="order_review">
                            <div class="mb-20">
                                <h4>Your Orders</h4>
                            </div>
                            <div class="table-responsive order_table text-center">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th colspan="2">Product</th>
                                            <th>Price</th>
                                            <th>Total</th>
                                        </tr>
                                    </thead>
                                    <% if(cart && cart.items.length>0){ %>
        
                                        <tbody>
                                            <% cart.items.forEach(item=>{ %>
                                                <tr>
                                                    <td class="image product-thumbnail"><img
                                                            src="/<%=item.productId.images[0] %>" alt="#"></td>
                                                    <td>
                                                        <h5><a href="shop-product-full.html">
                                                            <% if(item.quantity > item.productId.quantity)
                                                            {
                                                                qty =item.productId.quantity
                                                            }else {qty = item.quantity
                                                            }%>
                                                          
                                                                <%=item.productId.name %>
                                                            </a></h5> <span class="product-qty">x <%=qty %></span>
                                                    </td>
                                                    <td>
                                                        <%=item.price %>
                                                    </td>
                                                    <td>
                                                        <%=item.price * item.quantity%>
                                                    </td>
                                                </tr>
                                                <% }) %>
        
                                                    <tr>
                                                        <th>SubTotal</th>
                                                        <td class="product-subtotal" colspan="3">₹                                                           <%=cart.totalPrice %>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th>coupon Discount</th>
                                                        <td colspan="3"><em><%=cart.couponDiscount %></em></td>
                                                    </tr>
                                                    <tr>
                                                        <th>Total</th>
                                                        <td colspan="3" class="product-subtotal"><span
                                                                class="font-xl text-brand fw-900">
                                                                ₹ <%= cart.shippingTotal %>
                                                            </span></td>
                                                    </tr>
                                        </tbody>
                                        <% } %>
                                </table>
                            </div>
                            <div class="bt-1 border-color-1 mt-30 mb-30"></div>
                            <div class="payment_method">
                                <div class="mb-25">
                                    <h5>Payment</h5>
                                </div>
                                <div class="payment_option">
                                    <% if(cart.shippingTotal > 1000){ %>
                                        <p class="text-muted">COD not available for order above ₹1000</p>
                                    <% }else{ %>
                                    <div class="custome-radio">
                                        <input class="form-check-input" required="" type="radio" name="payment_option"
                                            id="exampleRadios3" value="COD" checked="">
                                        <label class="form-check-label" for="exampleRadios3" data-bs-toggle="collapse"
                                            data-target="#bankTranfer" >Cash On Delivery</label>
        
                                    </div>
                                    <% } %>
                                    <% if(cart.shippingTotal <= walletBalance){ %>
                                    <div class="custome-radio">
                                        <input class="form-check-input" required="" type="radio" name="payment_option"
                                            id="exampleRadios4" value="wallet" checked="">
                                        <label class="form-check-label" for="exampleRadios4" data-bs-toggle="collapse"
                                            data-target="#wallet" value="wallet">Wallet</label>
        
                                    </div>
                                    <% } %>
                                    <div class="custome-radio">
                                        <input class="form-check-input" required="" type="radio" name="payment_option"
                                            id="exampleRadios5" value="paypal" checked="">
                                        <label class="form-check-label" for="exampleRadios5" data-bs-toggle="collapse"
                                            data-target="#paypal" value="paypal">Paypal</label>
        
                                    </div>
                                    <div id="paypal-button-container"></div>

                                    <a href="#" onclick="placeOrder('<%=cart._id%>')" class="btn btn-fill-out btn-block mt-30">Place Order</a>
        
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const changeSelectedAddress = async(addressId)=>{
            try {
                const response = await fetch(`/checkout/changeAddress`,{
                    method:'PATCH',
                    headers:{
                        'Content-Type':'application/json'
                    },
                    body :JSON.stringify({ addressId: addressId })
                })
                if(response.ok) window.location.reload()
            } catch (error) {
                
            }
        }
  
         const diffAddress = async(id)=>{
                const form = document.getElementById('form-diff-address')
                try {
                    const data = new FormData(form)
                    let info = Object.fromEntries(data)   
                    const response = await fetch(`/profile/addNewAddress/${id}`,{
                        method:'PATCH',
                        headers:{
                            'Content-Type':'application/json'
                        },
                        body:JSON.stringify(info)
                    })
                   

                    if(response.ok) {
                        window.location.reload()
                    }
                } catch (error) {
                    console.error(error)
                }}

     const placeOrder = async(cartId)=>{
        console.log(cartId)
        try {
            const selectedPaymentOption = document.querySelector('input[name="payment_option"]:checked').value;
            const address = document.getElementById('addr')?.textContent.trim();
            const cityState = document.getElementById('cityState')?.textContent.trim();
            const fullAddress = address + " " + cityState;

            if (!address || !cityState) {
            Swal.fire({
                icon: 'error',
                title: 'Shipping Address is missing',
                showConfirmButton: false,
                timer: 2500
            });
            return; 
        }
            

           
            if (selectedPaymentOption === 'paypal') {
            // Show the PayPal button container
            document.getElementById('paypal-button-container').style.display = 'block';

            paypal.Buttons({
    createOrder: function(data, actions) {
        return fetch('/create-paypal-order', {
            method: 'post',
            headers: {
                'content-type': 'application/json'
            }
        }).then(function(res) {
            return res.json();
        }).then(function(orderData) {
            return orderData.id;
        });
    },
    onApprove: function(data, actions) {
        return actions.order.capture().then(async function(details) {
            alert('Transaction completed by ' + details.payer.name.given_name);
            
            let orderDetails ={
                cartId :cartId,
                paymentOption :selectedPaymentOption,
                deliveryAddress:fullAddress,
                transactionId : details.id
            }

            // Proceed with placing the order
            const response = await fetch('/placeOrder', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(orderDetails)
            });
            if (response.ok) {
                window.location.href = "/confirmOrder";
            }
        });
    },
    onError: function(err) {
        console.error('An error occurred during the transaction:', err);
        alert('An error occurred during the transaction. Please try again.');
    }
}).render('#paypal-button-container');

            } else  {
                let orderDetails ={
                cartId :cartId,
                paymentOption :selectedPaymentOption,
                deliveryAddress:fullAddress
               
            }
            const response = await fetch('/placeOrder', {
                method: 'POST',
                headers: {
                'Content-Type': 'application/json'
                },
                body: JSON.stringify(orderDetails)
            });
            if (response.ok) {
                Swal.fire({
                    icon: 'success',
                    title: 'Thank you for shopping with us',
                    showConfirmButton: false,
                    timer: 1500
                }).then(() => {
                    window.location.href = "/confirmOrder";
                });
               
            }
            }

        } catch (error) {
            console.log(error);
        }
        };
                
            
      
    </script>
 <%-include('../layoutUser/footer.ejs') %>